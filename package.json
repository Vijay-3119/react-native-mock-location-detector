{
  "name": "react-native-mock-gps-detector",
  "version": "1.0.1",
  "description": "Production-grade React Native library for detecting mocked, spoofed, or tampered GPS location signals on Android and iOS.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "files": [
    "src",
    "lib",
    "android/src",
    "android/build.gradle",
    "android/gradle.properties",
    "ios",
    "app.plugin.js",
    "react-native-mock-location-detector.podspec",
    "react-native.config.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "mock-location",
    "gps-spoofing",
    "location-spoofing",
    "fake-gps",
    "anti-fraud",
    "root-detection",
    "jailbreak-detection",
    "play-integrity",
    "app-attest",
    "turbomodule"
  ],
  "author": "Vijay",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.68.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "^9.0.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "react": "18.2.0",
    "react-native": "0.76.0",
    "typescript": "^5.0.0"
  },
  "codegenConfig": {
    "name": "RNMockLocationDetectorSpec",
    "type": "modules",
    "jsSrcDir": "src",
    "android": {
      "javaPackageName": "com.mocklocationdetector"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vijay-3119/react-native-mock-location-detector.git"
  },
  "bugs": {
    "url": "https://github.com/Vijay-3119/react-native-mock-location-detector/issues"
  },
  "homepage": "https://github.com/Vijay-3119/react-native-mock-location-detector#readme"
}